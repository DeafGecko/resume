---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Dwight Rogers // Resume">
      <html lang="en">
      <head>
            <meta charset="UTF-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
            <title>Dwight Rogers — Frontend Developer & Design Engineer</title>
            
            <!-- Google Fonts -->
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
            <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;900&family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap" rel="stylesheet" />
            
            <style>
            *, *::before, *::after {
                  box-sizing: border-box;
                  margin: 0;
                  padding: 0;
            }

            /* ── DYNAMIC THEME VARIABLES ── */
            :root {
                  /* Default Dark Mode */
                  --bg: #0a0a0a;
                  --text: #f0ede8;
                  --muted: #888480;
                  --faint: #2a2a2a;
                  --surface2: #161616;
                  --border: rgba(255, 255, 255, 0.08);
                  
                  /* Brand Colors */
                  --cyan: #388DF8;
                  --cyan-dim: rgba(56, 141, 248, 0.12);
                  
                  /* Interactive Card Values */
                  --card-bg: rgba(20, 20, 20, 0.5);
                  --card-bg-hover: rgba(25, 25, 25, 0.8);
                  --card-border: rgba(255, 255, 255, 0.04);
                  --glow-core: rgba(56, 141, 248, 0.6);
                  --bg-glow: rgba(56, 141, 248, 0.08);

                  /* Typography */
                  --mono: "DM Mono", monospace;
                  --sans: "DM Sans", sans-serif;
                  --heading: "Space Grotesk", sans-serif;
            }

            /* Light Mode Overrides (Relaxed on the eyes, darker text) */
            html.light-theme {
                  --bg: #f4f5f7; /* Softer, relaxing off-white background */
                  --text: #111827; /* Very dark slate for headings */
                  --muted: #374151; /* Dark gray for easy-to-read <p> text */
                  --faint: #e5e7eb;
                  --surface2: #e5e7eb;
                  --border: rgba(0, 0, 0, 0.1);
                  --cyan-dim: rgba(56, 141, 248, 0.15);
                  
                  --card-bg: rgba(255, 255, 255, 0.7); /* Soft glass effect */
                  --card-bg-hover: rgba(255, 255, 255, 1);
                  --card-border: rgba(0, 0, 0, 0.08);
                  --glow-core: rgba(56, 141, 248, 1);
                  --bg-glow: rgba(56, 141, 248, 0.03);
            }

            html {
                  background: var(--bg);
                  color: var(--text);
                  font-family: var(--sans);
                  font-size: 15px;
                  line-height: 1.5;
                  transition: background 0.3s ease, color 0.3s ease;
            }

            body {
                  min-height: 100vh;
                  background: var(--bg);
            }

            /* TYPOGRAPHY */
            h1, h2, h3, h4, h5, h6, 
            .project-name, .job-title, .cert-name, .section-label, .skill-group-name {
                  font-family: var(--heading) !important;
                  letter-spacing: -0.02em;
            }

            a { color: var(--cyan); text-decoration: none; }
            a:hover { text-decoration: underline; }

            /* SKIP LINK */
            .skip-link {
                  position: absolute; top: -100%; left: 1rem;
                  background: var(--cyan); color: #000;
                  padding: 8px 16px; border-radius: 4px; z-index: 100;
            }
            .skip-link:focus { top: 1rem; }

            /* GLOBAL CURSOR GLOW */
            #cursor-glow {
                  position: fixed; width: 400px; height: 400px;
                  background: radial-gradient(circle, var(--bg-glow) 0%, transparent 60%);
                  border-radius: 50%; pointer-events: none;
                  z-index: 0; transform: translate(-50%, -50%);
            }

            /* LAYOUT */
            .page {
                  max-width: 900px;
                  margin: 0 auto;
                  padding: 2rem 2rem 4rem;
                  position: relative; z-index: 1; 
            }

            /* HEADER */
            .header {
                  display: flex;
                  justify-content: space-between;
                  align-items: flex-end;
                  padding-bottom: 1.5rem;
                  border-bottom: 1px solid var(--border);
                  margin-bottom: 2rem;
            }

            .header-left { flex: 1; }

            .eyebrow {
                  font-family: var(--mono); font-size: 10px;
                  letter-spacing: 0.15em; color: var(--cyan);
                  text-transform: uppercase; margin-bottom: 0.5rem;
                  display: flex; align-items: center; gap: 8px;
            }
            .eyebrow::before { content: ""; width: 20px; height: 1px; background: var(--cyan); }

            h1.name {
                  font-size: clamp(2.2rem, 5vw, 2.8rem);
                  font-weight: 900;
                  line-height: 1;
                  color: var(--text);
                  margin-bottom: 0.5rem;
            }
            h1.name span { color: var(--cyan); font-weight: 900; }

            .tagline {
                  font-size: 13.5px; color: var(--muted);
                  font-weight: 400; max-width: 500px; line-height: 1.5;
            }

            .header-links {
                  display: flex; flex-direction: column; gap: 6px; align-items: flex-end;
            }
            .header-link {
                  display: flex; align-items: center; gap: 6px;
                  font-family: var(--mono); font-size: 11px; color: var(--muted);
            }
            .header-link:hover { color: var(--text); text-decoration: none; }
            .header-link svg { width: 13px; height: 13px; }

            /* GRID LAYOUT */
            .resume-body {
                  display: grid;
                  grid-template-columns: 1fr 260px;
                  gap: 2rem;
                  align-items: start;
            }

            .section { margin-bottom: 2rem; }
            .section-label {
                  font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase;
                  color: var(--muted); margin-bottom: 1rem;
                  display: flex; align-items: center; gap: 10px;
            }
            .section-label::after { content: ""; flex: 1; height: 1px; background: var(--faint); }

            /* ALIVE GLASSMORPHISM CARDS */
            .glass-card {
                  position: relative;
                  background: var(--card-bg);
                  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
                  border-radius: 8px;
                  padding: 1rem 1.25rem;
                  margin-bottom: 0.75rem;
                  transition: transform 0.2s ease, background 0.2s ease;
                  z-index: 1; overflow: hidden;
                  border: 1px solid var(--card-border); 
                  break-inside: avoid;
                  page-break-inside: avoid;
            }

            .glass-card::before {
                  content: ""; position: absolute; inset: 0;
                  border-radius: inherit; padding: 1px;
                  background: radial-gradient(
                        350px circle at var(--mouse-x, -500px) var(--mouse-y, -500px),
                        var(--glow-core), transparent 40%
                  );
                  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
                  -webkit-mask-composite: xor; mask-composite: exclude;
                  z-index: -1; transition: opacity 0.3s ease;
            }

            .glass-card:hover { transform: translateY(-2px); background: var(--card-bg-hover); }

            /* CARD CONTENTS */
            .job-header, .project-header {
                  display: flex; justify-content: space-between; align-items: flex-start;
                  gap: 1rem; margin-bottom: 0.2rem;
            }
            .job-title, .project-name { font-size: 15px; font-weight: 600; color: var(--text); }
            .job-date, .project-link { font-family: var(--mono); font-size: 10px; color: var(--muted); }
            .job-org { font-size: 12px; color: var(--cyan); font-family: var(--mono); margin-bottom: 0.4rem; }
            
            /* Enhanced Paragraph legibility */
            .job-desc, .project-desc { 
                  font-size: 13.5px; 
                  color: var(--muted); 
                  line-height: 1.6; 
                  font-weight: 400; /* Bumped slightly for crispness */
            }
            
            .project-desc { margin-bottom: 8px; }
            .project-tags { display: flex; flex-wrap: wrap; gap: 4px; }
            .tag {
                  font-family: var(--mono); font-size: 9px; padding: 2px 6px;
                  border-radius: 3px; background: var(--surface2); color: var(--muted);
                  border: 1px solid var(--border);
            }
            .tag.accent { background: var(--cyan-dim); color: var(--cyan); border-color: rgba(56, 141, 248, 0.2); }

            /* SIDEBAR SKILLS */
            .skill-group { margin-bottom: 1rem; break-inside: avoid; }
            .skill-group-name { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
            .skills-list { display: flex; flex-wrap: wrap; gap: 4px; }
            .skill {
                  font-size: 11px; padding: 3px 8px; border-radius: 4px;
                  background: var(--surface2); border: 1px solid var(--border); color: var(--text);
            }
            .skill.primary { background: var(--cyan-dim); color: var(--cyan); border-color: transparent; }

            /* EDUCATION & CERT */
            .edu-item { margin-bottom: 0.75rem; break-inside: avoid; }
            .edu-degree, .cert-name { font-size: 13px; font-weight: 600; color: var(--text); }
            .edu-school, .cert-issuer { font-size: 11px; color: var(--muted); font-family: var(--mono); }

            /* AVAILABILITY */
            .avail-badge {
                  display: inline-flex; align-items: center; gap: 6px;
                  background: var(--cyan-dim); border: 1px solid rgba(56, 141, 248, 0.2);
                  border-radius: 20px; padding: 4px 12px; font-size: 11px;
                  color: var(--cyan); font-family: var(--mono); margin-bottom: 1.5rem;
            }
            .avail-dot {
                  width: 6px; height: 6px; border-radius: 50%; background: var(--cyan);
                  animation: pulse-dot 2s ease-in-out infinite;
            }
            @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

            /* ACTIONS */
            .actions { position: fixed; bottom: 2rem; right: 2rem; display: flex; gap: 8px; z-index: 50; }
            .btn {
                  display: flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 6px;
                  font-size: 12px; font-family: var(--mono); cursor: pointer; border: 1px solid var(--border);
            }
            .btn-primary { background: var(--cyan); color: #000; font-weight: 600; border: none; }
            .btn-primary:hover { background: #2a7be6; color: #fff; }
            .btn-secondary { background: var(--surface2); color: var(--text); }

            /* ── PERFECT PDF/PRINT STYLES ── */
            @media print {
                  @page { margin: 0.4in; size: letter; }
                  
                  /* Forces Highly Readable Light Mode Variables */
                  html { 
                        font-size: 11px;
                        --bg: #ffffff; /* Paper white */
                        --text: #000000; /* Pure black for headings */
                        --muted: #333333; /* Very dark gray for descriptions */
                        --faint: #e0e0e0;
                        --surface2: #f0f0f0;
                        --border: rgba(0, 0, 0, 0.15);
                        --card-bg: #ffffff;
                        --card-border: rgba(0, 0, 0, 0.2);
                  }
                  
                  body { background: var(--bg); color: var(--text); }
                  .page { padding: 0; max-width: 100%; width: 100%; }
                  .actions, .avail-badge, #cursor-glow { display: none !important; }
                  
                  .resume-body { 
                        display: grid !important; 
                        grid-template-columns: 1fr 220px !important; 
                        gap: 1.5rem !important; 
                  }
                  
                  .glass-card { 
                        background: var(--card-bg) !important;
                        border: 2px solid var(--card-border) !important;
                        padding: 0.75rem 1rem !important;
                        margin-bottom: 0.5rem !important;
                        transform: none !important;
                  }
                  .glass-card::before { display: none !important; }
                  
                  /* Exact PDF Overrides for Typography */
                  h1.name, h1.name span { color: var(--cyan) !important; }
                  .job-title, .project-name, .cert-name, .edu-degree { color: #000 !important; }
                  .eyebrow, .job-org, a { color: var(--cyan) !important; }
                  .tag, .skill { background: var(--surface2) !important; border: 1px solid var(--border) !important; color: var(--text) !important; }
            }

            /* RESPONSIVE */
            @media (max-width: 768px) {
                  .header { flex-direction: column; align-items: flex-start; gap: 1rem; }
                  .header-links { align-items: flex-start; }
                  .resume-body { grid-template-columns: 1fr; gap: 2rem; }
                  .actions, #cursor-glow, .glass-card::before { display: none; }
            }
            </style>
      </head>
      <body>
